# ===================================
# AIOps RAG System 環境變數設定
# ===================================
# 請複製此檔案為 .env 並填入您的設定值
# cp .env.example .env

# ===================================
# API 設定
# ===================================
# API 服務標題
API_TITLE="AIOps 智慧維運報告 RAG 系統"

# API 版本號
API_VERSION="1.0.0"

# ===================================
# Google Gemini AI 設定
# ===================================
# Gemini API Key (必需)
# 請至 https://makersuite.google.com/app/apikey 申請
# 或至 https://aistudio.google.com/app/apikey (Google AI Studio)
GEMINI_API_KEY="your-gemini-api-key-here"

# ⚠️ Google 會定期退役舊模型（gemini-1.5-* 系列已下線，2.5 系列預計 2026-10 停用）。
#    部署前請至 https://ai.google.dev/gemini-api/docs/models 確認目前可用的模型 ID，
#    並用下面兩個環境變數覆寫，不需要改動程式碼。

# Gemini Flash 模型名稱
# 用於快速回應的輕量級模型
GEMINI_FLASH_MODEL="gemini-3.5-flash"

# Gemini Pro 模型名稱
# 用於需要高品質回應的進階模型
GEMINI_PRO_MODEL="gemini-3.1-pro"

# ===================================
# OpenSearch 設定
# ===================================
# OpenSearch 主機位址
# Docker 環境請使用容器名稱: opensearch
# 本地開發請使用: localhost
OPENSEARCH_HOST="opensearch"

# OpenSearch 連接埠
# 預設值: 9200
OPENSEARCH_PORT=9200

# OpenSearch 索引名稱
# 用於儲存知識庫文件的索引
# 預設值: aiops-knowledge-base
OPENSEARCH_INDEX="aiops-knowledge-base"

# OpenSearch 向量維度
# 必須與嵌入模型的輸出維度相符
# 預設值: 768 (適用於 text-embedding-3-small)
OPENSEARCH_EMBEDDING_DIM=768

# OpenSearch 認證設定 (如果有啟用安全性)
# 預設 Docker 環境已關閉安全性插件
# OPENSEARCH_USER="admin"
# OPENSEARCH_PASSWORD="admin"

# ===================================
# Prometheus 監控設定
# ===================================
# Prometheus 主機位址
# Docker 環境請使用容器名稱: prometheus
# 本地開發請使用: localhost
PROMETHEUS_HOST="prometheus"

# Prometheus 連接埠
# 預設值: 9090
PROMETHEUS_PORT=9090

# ===================================
# Redis 設定 (用於 LangGraph 狀態管理)
# ===================================
# Redis 連線 URL
# 格式: redis://[user]:[password]@[host]:[port]/[db]
# Docker 環境: redis://redis:6379
# 本地開發: redis://localhost:6379
REDIS_URL="redis://redis:6379"

# ===================================
# RAG 系統設定
# ===================================
# 向量搜尋返回的最大結果數
# 預設值: 5
TOP_K_RESULTS=5

# 摘要的最大長度（字元數）
# 預設值: 150
MAX_SUMMARY_LENGTH=150

# ===================================
# 可觀測性設定
# ===================================
# 環境標識 (development, staging, production)
ENVIRONMENT="development"

# 日誌等級 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL="INFO"

# 是否輸出 JSON 格式日誌
# 預設值: true
JSON_LOGS="true"

# 日誌檔案路徑（選填）
# 留空則只輸出到控制台
# LOG_FILE="/var/log/aiops/app.log"

# ===================================
# 分散式追蹤設定 (OTLP)
# ===================================
# OTLP 端點（選填，留空則不送出 trace）
# 追蹤一律走 OTLP；Jaeger 原生支援 OTLP 接收，直接指向它即可。
# Docker 環境: jaeger:4317
# 本地開發: localhost:4317
# 若使用 OpenTelemetry Collector: otel-collector:4317
# 註：舊的 JAEGER_ENDPOINT（agent UDP 6831）已移除，
#     因 opentelemetry-exporter-jaeger 已被官方 deprecated。
OTLP_ENDPOINT="jaeger:4317"

# 是否在控制台輸出追蹤資訊
# 預設值: false (建議生產環境保持關閉)
TRACE_CONSOLE="false"

# ===================================
# 服務埠號設定
# ===================================
# API 服務埠號
# 預設值: 8000
API_PORT=8000

# Metrics 服務埠號（Prometheus 抓取端點）
# 預設值: 8000 (與 API 共用)
METRICS_PORT=8000

# ===================================
# 開發環境設定
# ===================================
# 是否啟用測試模式
# 測試時會使用 Mock 模型避免 API 呼叫
# 預設值: false
TESTING="false"

# ===================================
# 其他服務設定（選填）
# ===================================
# 如果需要整合 OpenAI (目前為選用)
# OPENAI_API_KEY="your-openai-api-key-here"

# Grafana 管理員密碼
# 預設值: admin
GF_SECURITY_ADMIN_PASSWORD="admin"